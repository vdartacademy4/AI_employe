# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses SQLite. For PostgreSQL replace the value with, e.g.
#   postgresql://user:password@localhost:5432/aiep?schema=public
# and set `provider = "postgresql"` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Security - generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-me-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Keyed hash used for anonymous survey ownership receipts. Must differ from the
# JWT secrets above.
ANALYTICS_HMAC_SECRET=replace-me-with-a-different-long-random-secret

# ---------------------------------------------------------------------------
# Bootstrap admin (consumed only by `npm run db:seed`)
# The seed creates this single account and no business/demo data.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_123!
ADMIN_NAME=Platform Administrator

# ---------------------------------------------------------------------------
# AI provider
# `AI_PROVIDER` selects the implementation in src/modules/ai/providers:
#   null    - no inference; returns an explicit "not configured" response
#   gemini  - Google's Gemini generateContent API (native shape)
#   http    - any OpenAI-compatible /chat/completions endpoint
# ---------------------------------------------------------------------------
AI_PROVIDER=null

# Gemini (AI_PROVIDER=gemini). Sent as the `x-goog-api-key` header.
GEMINI_API_KEY=

# OpenAI-compatible endpoints (AI_PROVIDER=http).
AI_API_KEY=

# Unset uses the provider default: gemini-3.5-flash-lite for Gemini,
# https://api.openai.com/v1 for the http provider.
# NOTE: gemini-2.5-flash and gemini-2.5-flash-lite are retired for newly issued
# API keys and return HTTP 404. gemini-3.5-flash works but is a reasoning model
# (~23s for a one-line reply), so it is a poor default for an interactive chat.
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=30000

# Reasoning models spend this on internal tokens before emitting visible text.
# Too small a value yields an empty completion.
AI_MAX_OUTPUT_TOKENS=2048
